# Copy to .env.local for local development. Never commit real values.
# Values from `npx supabase status` (local) or the Supabase dashboard (hosted).
# EXPO_PUBLIC_* values are bundled into the app, so only use the public URL and publishable key (sb_publishable_...) here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production site URL for canonical/Open Graph tags, sitemap.xml and robots.txt (build time only, see scripts/seo.js).
# Optional: on Vercel it defaults to the project's production domain (VERCEL_PROJECT_PRODUCTION_URL); locally to localhost.
# SITE_URL=https://mygymly.com
