# Copy to .env.local for local development. Never commit real values.
# Values from `npx supabase status` (local) or the Supabase dashboard (hosted).
# EXPO_PUBLIC_* values are bundled into the app, so only use the public URL and publishable/anon key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
